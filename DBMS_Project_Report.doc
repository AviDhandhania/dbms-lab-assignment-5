        #queryResultTable { color: white; border: 1px solid #333; margin-bottom: 0;}
        #queryResultTable th { background-color: #333; color: #ccc; border-bottom: 1px solid #555; }
        #queryResultTable td { border-bottom: 1px solid #333; }
        
        /* Two columns layout for main area */
        .two-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 30px; }

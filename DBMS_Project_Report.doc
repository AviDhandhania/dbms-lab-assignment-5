            &lt;button class="secondary-btn" id="exportBtn" style="display:none;" onclick="exportCSV()"&gt;Export CSV&lt;/button&gt;
        &lt;/div&gt;
        
        &lt;div id="queryResult"&gt;&lt;em&gt;Query results will appear here...&lt;/em&gt;&lt;/div&gt;
    &lt;/div&gt;

&lt;/div&gt;

&lt;script&gt;
    const QUERY_URL = 'http://localhost:8080/api/query';
    let currentTable = '';
    let currentColumns = [];

    document.addEventListener("DOMContentLoaded", () =&gt; {
        refreshTables();
        loadHistoryDropdown();
    });

    function showAlert(id, message, isError = false) {
        const el = document.getElementById(id);
        el.style.display = 'block';
        el.textContent = message;
        el.className = 'alert ' + (isError ? 'error' : 'success');
        setTimeout(() =&gt; { el.style.display = 'none'; }, 4000);
    }

    async function executeSQL(query) {
        const response = await fetch(QUERY_URL, {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: `query=${encodeURIComponent(query)}`
        });
        return response.json();
    }

    // --- Table Management ---

    async function refreshTables() {
        // Fetch all user tables in Oracle
        const data = await executeSQL("SELECT table_name FROM user_tables ORDER BY table_name");
        const sel = document.getElementById('tableSelect');
        const prevVal = sel.value;
        sel.innerHTML = '&lt;option value=""&gt;-- Select a Table --&lt;/option&gt;';
        if(data.data) {
            data.data.forEach(row =&gt; {
                sel.innerHTML += `&lt;option value="${row.TABLE_NAME}"&gt;${row.TABLE_NAME}&lt;/option&gt;`;
            });
        }
        if(prevVal) { sel.value = prevVal; }
    }

    async function loadTableData() {
        const t = document.getElementById('tableSelect').value;
        currentTable = t;
        const th = document.getElementById('dataTableHead');
        const tb = document.getElementById('dataTableBody');
        document.getElementById('dynamicFormArea').style.display = 'none';
        
        if(!t) {
            th.innerHTML = '&lt;tr&gt;&lt;th&gt;Please select a table&lt;/th&gt;&lt;/tr&gt;';
            tb.innerHTML = '';
            return;
        }

        th.innerHTML = '&lt;tr&gt;&lt;th&gt;Loading...&lt;/th&gt;&lt;/tr&gt;';
        tb.innerHTML = '';

        // 1. Get Columns
        const colRes = await executeSQL(`SELECT column_name, data_type FROM user_tab_cols WHERE table_name = '${t}' ORDER BY column_id`);
        if(colRes.data) {
            currentColumns = colRes.data.map(c =&gt; c.COLUMN_NAME);
            let headRow = '&lt;tr&gt;';
            currentColumns.forEach(c =&gt; headRow += `&lt;th&gt;${c}&lt;/th&gt;`);
            headRow += '&lt;th style="width:80px;"&gt;Actions&lt;/th&gt;&lt;/tr&gt;';
            th.innerHTML = headRow;
        }

        // 2. Get Data
        const dataRes = await executeSQL(`SELECT * FROM ${t}`);
        if(dataRes.data) {
            if(dataRes.data.length === 0) {
                tb.innerHTML = `&lt;tr&gt;&lt;td colspan="${currentColumns.length + 1}" style="text-align:center;"&gt;No rows found.&lt;/td&gt;&lt;/tr&gt;`;
            } else {
                dataRes.data.forEach(row =&gt; {
                    let tr = '&lt;tr&gt;';
                    currentColumns.forEach(c =&gt; {
                        tr += `&lt;td&gt;${row[c] !== null ? row[c] : '&lt;em&gt;null&lt;/em&gt;'}&lt;/td&gt;`;
                    });
                    
                    // Generate a delete condition based on first column (heuristic for PK)
                    const pkCol = currentColumns[0];
                    const pkVal = row[pkCol];
                    let delArg = typeof pkVal === 'number' ? pkVal : `'${pkVal}'`;
                    
                    tr += `&lt;td&gt;&lt;button class="danger-btn" style="padding:4px 8px; font-size:11px;" onclick="deleteRow('${pkCol}', ${delArg})"&gt;Del&lt;/button&gt;&lt;/td&gt;&lt;/tr&gt;`;
                    tb.innerHTML += tr;
                });
            }
        } else if (dataRes.error) {
            showAlert('tableAlert', dataRes.error, true);
        }
    }

    async function deleteRow(col, val) {
        if(!confirm(`Delete row where ${col} = ${val}?`)) return;
        const query = `DELETE FROM ${currentTable} WHERE ${col} = ${val}`;
        const res = await executeSQL(query);
        if(res.error) showAlert('tableAlert', res.error, true);
        else {
            showAlert('tableAlert', 'Row deleted successfully.');
            loadTableData();
        }
    }

    function showAddRow() {
        if(!currentTable) return showAlert('tableAlert', 'Please select a table first.', true);
        const area = document.getElementById('dynamicFormArea');
        let html = `&lt;h3&gt;Add Row to ${currentTable}&lt;/h3&gt;`;
        currentColumns.forEach(c =&gt; {
            html += `&lt;div class="form-group"&gt;&lt;label&gt;${c}&lt;/label&gt;&lt;input type="text" id="insert_${c}"&gt;&lt;/div&gt;`;
        });
        html += `&lt;button onclick="submitInsert()"&gt;Insert&lt;/button&gt; &lt;button class="cancel-btn" onclick="document.getElementById('dynamicFormArea').style.display='none'"&gt;Cancel&lt;/button&gt;`;
        area.innerHTML = html;
        area.style.display = 'block';
    }

    async function submitInsert() {
        let cols = [];
        let vals = [];
        currentColumns.forEach(c =&gt; {
            const v = document.getElementById(`insert_${c}`).value;
            if(v) {
                cols.push(c);
                vals.push(`'${v.replace(/'/g, "''")}'`); // escape quotes
            }
        });
        const query = `INSERT INTO ${currentTable} (${cols.join(',')}) VALUES (${vals.join(',')})`;
        const res = await executeSQL(query);
        if(res.error) showAlert('tableAlert', res.error, true);
        else {
            showAlert('tableAlert', 'Row inserted successfully!');
            document.getElementById('dynamicFormArea').style.display = 'none';
            loadTableData();
        }
    }

    function showCreateTable() {
        const area = document.getElementById('dynamicFormArea');
        area.innerHTML = `
            &lt;h3&gt;Create New Table&lt;/h3&gt;
            &lt;div class="form-group"&gt;
                &lt;label&gt;Table Name (e.g. PRODUCTS)&lt;/label&gt;
                &lt;input type="text" id="newTableName" placeholder="PRODUCTS"&gt;
            &lt;/div&gt;
            &lt;div class="form-group"&gt;
                &lt;label&gt;Columns Definition (SQL format)&lt;/label&gt;
                &lt;textarea id="newTableCols" placeholder="id NUMBER PRIMARY KEY,
name VARCHAR2(100),
price NUMBER"&gt;&lt;/textarea&gt;
            &lt;/div&gt;
            &lt;button onclick="submitCreateTable()"&gt;Create Table&lt;/button&gt;
            &lt;button class="cancel-btn" onclick="document.getElementById('dynamicFormArea').style.display='none'"&gt;Cancel&lt;/button&gt;
        `;
        area.style.display = 'block';
    }

    async function submitCreateTable() {
        const name = document.getElementById('newTableName').value.toUpperCase();
        const cols = document.getElementById('newTableCols').value;
        if(!name || !cols) return showAlert('tableAlert', 'Table name and columns required.', true);
        
        const query = `CREATE TABLE ${name} (${cols})`;
        const res = await executeSQL(query);
        if(res.error) showAlert('tableAlert', res.error, true);
        else {
            showAlert('tableAlert', `Table ${name} created!`);
            document.getElementById('dynamicFormArea').style.display = 'none';
            await refreshTables();
            document.getElementById('tableSelect').value = name;
            loadTableData();
        }
    }

    async function dropCurrentTable() {
        if(!currentTable) return showAlert('tableAlert', 'Please select a table to drop.', true);
        if(!confirm(`WARNING: Are you sure you want to completely DROP the table '${currentTable}' and all its data?`)) return;
        
        const res = await executeSQL(`DROP TABLE ${currentTable}`);
        if(res.error) showAlert('tableAlert', res.error, true);
        else {
            showAlert('tableAlert', `Table ${currentTable} dropped.`);
            currentTable = '';
            await refreshTables();
            loadTableData();
        }
    }

    // --- Query Runner ---

    let currentResultSet = null;

    function saveToHistory(query) {
        let history = JSON.parse(localStorage.getItem('queryHistory') || '[]');
        if(!history.includes(query)) {
            history.unshift(query); 
            if(history.length &gt; 10) history.pop();
            localStorage.setItem('queryHistory', JSON.stringify(history));
            loadHistoryDropdown();
        }
    }

    function loadHistoryDropdown() {
        const history = JSON.parse(localStorage.getItem('queryHistory') || '[]');
        const sel = document.getElementById('queryHistory');
        sel.innerHTML = '&lt;option value=""&gt;-- History --&lt;/option&gt;';
        history.forEach((q, i) =&gt; {
            let snippet = q.length &gt; 20 ? q.substring(0,20) + '...' : q;
            sel.innerHTML += `&lt;option value="${i}"&gt;${snippet}&lt;/option&gt;`;
        });
    }

    function loadQueryFromHistory() {
        const history = JSON.parse(localStorage.getItem('queryHistory') || '[]');
        const idx = document.getElementById('queryHistory').value;
        if(idx !== "") document.getElementById('sqlQuery').value = history[idx];
    }

    function clearQuery() {
        document.getElementById('sqlQuery').value = '';
        document.getElementById('queryResult').innerHTML = '&lt;em&gt;Query results will appear here...&lt;/em&gt;';
        document.getElementById('exportBtn').style.display = 'none';
        currentResultSet = null;
    }

    async function runQuery() {
        const query = document.getElementById('sqlQuery').value;
        const resDiv = document.getElementById('queryResult');
        if (!query.trim()) return resDiv.innerHTML = '&lt;span style="color: #ff5555;"&gt;Please enter a query.&lt;/span&gt;';

        saveToHistory(query);
        resDiv.innerHTML = 'Executing...';
        document.getElementById('exportBtn').style.display = 'none';
        currentResultSet = null;

        const data = await executeSQL(query);
        
        if (data.error) {
            resDiv.innerHTML = '&lt;span style="color: #ff5555;"&gt;Error:&lt;br&gt;' + data.error + '&lt;/span&gt;';
        } else if (data.data) {
            if (data.data.length === 0) {
                resDiv.innerHTML = '&lt;em&gt;Query returned 0 rows.&lt;/em&gt;';
            } else {
                currentResultSet = data.data; 
                document.getElementById('exportBtn').style.display = 'inline-block';
                let html = '&lt;table id="queryResultTable"&gt;&lt;thead&gt;&lt;tr&gt;';
                Object.keys(data.data[0]).forEach(k =&gt; html += `&lt;th&gt;${k}&lt;/th&gt;`);
                html += '&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;';
                data.data.forEach(row =&gt; {
                    html += '&lt;tr&gt;';
                    Object.values(row).forEach(v =&gt; html += `&lt;td&gt;${v !== null ? v : 'null'}&lt;/td&gt;`);
                    html += '&lt;/tr&gt;';
                });
                html += '&lt;/tbody&gt;&lt;/table&gt;';
                resDiv.innerHTML = html;
            }
        } else {
            resDiv.innerHTML = `&lt;span style="color: #55ff55;"&gt;${data.message}&lt;/span&gt;`;
            refreshTables(); // just in case it was a DDL query
        }
    }

    function exportCSV() {
        if(!currentResultSet || currentResultSet.length === 0) return;
        const keys = Object.keys(currentResultSet[0]);
        let csvContent = "data:text/csv;charset=utf-8," + keys.join(",") + "\n";
        currentResultSet.forEach(row =&gt; {
            const rowStr = keys.map(k =&gt; {
                let cell = row[k] === null ? '' : String(row[k]);
                if(cell.includes(',') || cell.includes('"')) cell = `"${cell.replace(/"/g, '""')}"`;
                return cell;
            }).join(",");
            csvContent += rowStr + "\n";
        });
        const encodedUri = encodeURI(csvContent);
        const link = document.createElement("a");
        link.setAttribute("href", encodedUri);
        link.setAttribute("download", "query_export.csv");
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
    }
&lt;/script&gt;

&lt;/body&gt;
&lt;/html&gt;

</pre>

<!-- Section 9 -->
<h2>9. Complete Source Code - Backend (BackendCRUD.java)</h2>
<p>The following is the complete source code for the Java HTTP Server and JDBC database integration.</p>
<pre>
import com.sun.net.httpserver.HttpExchange;
import com.sun.net.httpserver.HttpHandler;
import com.sun.net.httpserver.HttpServer;

import java.io.IOException;
import java.io.InputStream;
import java.io.OutputStream;
import java.net.InetSocketAddress;
import java.nio.charset.StandardCharsets;
import java.sql.*;
import java.util.HashMap;
import java.util.Map;

public class BackendCRUD {
    // Database credentials for local Oracle XE setup
    static final String DB_URL = "jdbc:oracle:thin:@//localhost:1521/XE";
    static final String USER = "system";
    static final String PASS = "oracle";

    public static void main(String[] args) {
        try {
            // Ensure driver is loaded
            Class.forName("oracle.jdbc.driver.OracleDriver");
            
            // Check connection and create table if not exists
            try (Connection conn = DriverManager.getConnection(DB_URL, USER, PASS)) {
                System.out.println("Connected to Oracle Database successfully!");
                createTableIfNotExists(conn);
            } catch (SQLException e) {
                System.err.println("Database Error during startup: " + e.getMessage());
            }

            // Start HTTP Server on port 8080
            HttpServer server = HttpServer.create(new InetSocketAddress(8080), 0);
            server.createContext("/api/users", new ApiHandler());
            server.createContext("/api/query", new QueryHandler());
            server.setExecutor(null);
            server.start();
            System.out.println("Backend Server is running at http://localhost:8080");

        } catch (ClassNotFoundException e) {
            System.err.println("Driver Error: ojdbc6.jar not found on classpath.");
        } catch (IOException e) {
            System.err.println("Server Error: " + e.getMessage());
        }
    }

    private static void createTableIfNotExists(Connection conn) {
        String checkTable = "SELECT count(*) FROM user_tables WHERE table_name = 'USERS_CRUD'";
        try (Statement stmt = conn.createStatement(); ResultSet rs = stmt.executeQuery(checkTable)) {
            if (rs.next() &amp;&amp; rs.getInt(1) == 0) {
                String createTable = "CREATE TABLE USERS_CRUD (" +
                        "id NUMBER PRIMARY KEY, " +
                        "name VARCHAR2(100), " +
                        "email VARCHAR2(100))";
                stmt.execute(createTable);
                System.out.println("Table USERS_CRUD created successfully.");
            }
        } catch (SQLException e) {
            System.err.println("Table setup error: " + e.getMessage());
        }
    }

    static class ApiHandler implements HttpHandler {
        @Override
        public void handle(HttpExchange exchange) throws IOException {
            exchange.getResponseHeaders().add("Access-Control-Allow-Origin", "*");
            exchange.getResponseHeaders().add("Access-Control-Allow-Methods", "GET, POST, PUT, DELETE, OPTIONS");

            if ("OPTIONS".equals(exchange.getRequestMethod())) {
                exchange.sendResponseHeaders(204, -1);
                return;
            }

            String method = exchange.getRequestMethod();
            String response = "";
            int statusCode = 200;

            try (Connection conn = DriverManager.getConnection(DB_URL, USER, PASS)) {
                if ("GET".equals(method)) {
                    response = handleGet(conn);
                } else if ("POST".equals(method)) {
                    handlePost(exchange, conn);
                    response = "{\"status\":\"success\"}";
                } else if ("PUT".equals(method)) {
                    handlePut(exchange, conn);
                    response = "{\"status\":\"success\"}";
                } else if ("DELETE".equals(method)) {
                    handleDelete(exchange, conn);
                    response = "{\"status\":\"success\"}";
                }
            } catch (SQLException e) {
                statusCode = 500;
                response = "{\"error\": \"" + e.getMessage().replace("\"", "\\\"") + "\"}";
                e.printStackTrace();
            }

            byte[] bytes = response.getBytes(StandardCharsets.UTF_8);
            exchange.getResponseHeaders().set("Content-Type", "application/json");
            exchange.sendResponseHeaders(statusCode, bytes.length);
            OutputStream os = exchange.getResponseBody();
            os.write(bytes);
            os.close();
        }

        private String handleGet(Connection conn) throws SQLException {
            StringBuilder sb = new StringBuilder();
            sb.append("[");
            try (Statement stmt = conn.createStatement();
                 ResultSet rs = stmt.executeQuery("SELECT id, name, email FROM USERS_CRUD ORDER BY id")) {
                boolean first = true;
                while (rs.next()) {
                    if (!first) sb.append(",");
                    sb.append(String.format("{\"id\":%d, \"name\":\"%s\", \"email\":\"%s\"}",
                            rs.getInt("id"),
                            escapeJson(rs.getString("name")),
                            escapeJson(rs.getString("email"))));
                    first = false;
                }
            }
            sb.append("]");
            return sb.toString();
        }

        private void handlePost(HttpExchange exchange, Connection conn) throws IOException, SQLException {
            Map&lt;String, String&gt; params = parseBody(exchange);
            String name = params.get("name");
            String email = params.get("email");

            String sql = "INSERT INTO USERS_CRUD (id, name, email) VALUES ((SELECT COALESCE(MAX(id), 0) + 1 FROM USERS_CRUD), ?, ?)";
            try (PreparedStatement pstmt = conn.prepareStatement(sql)) {
                pstmt.setString(1, name);
                pstmt.setString(2, email);
                pstmt.executeUpdate();
            }
        }

        private void handlePut(HttpExchange exchange, Connection conn) throws IOException, SQLException {
            Map&lt;String, String&gt; params = parseBody(exchange);
            int id = Integer.parseInt(params.get("id"));
            String name = params.get("name");
            String email = params.get("email");

            String sql = "UPDATE USERS_CRUD SET name = ?, email = ? WHERE id = ?";
            try (PreparedStatement pstmt = conn.prepareStatement(sql)) {
                pstmt.setString(1, name);
                pstmt.setString(2, email);
                pstmt.setInt(3, id);
                pstmt.executeUpdate();
            }
        }

        private void handleDelete(HttpExchange exchange, Connection conn) throws IOException, SQLException {
            Map&lt;String, String&gt; params = parseBody(exchange);
            int id = Integer.parseInt(params.get("id"));

            String sql = "DELETE FROM USERS_CRUD WHERE id = ?";
            try (PreparedStatement pstmt = conn.prepareStatement(sql)) {
                pstmt.setInt(1, id);
                pstmt.executeUpdate();
            }
        }

        private Map&lt;String, String&gt; parseBody(HttpExchange exchange) throws IOException {
            InputStream is = exchange.getRequestBody();
            String body = new String(is.readAllBytes(), StandardCharsets.UTF_8);
            Map&lt;String, String&gt; map = new HashMap&lt;&gt;();
            String[] pairs = body.split("&amp;");
            for (String pair : pairs) {
                String[] kv = pair.split("=");
                if (kv.length == 2) {
                    map.put(kv[0], java.net.URLDecoder.decode(kv[1], StandardCharsets.UTF_8));
                }
            }
            return map;
        }

        private String escapeJson(String data) {
            if (data == null) return "";
            return data.replace("\\", "\\\\").replace("\"", "\\\"");
        }
    }

    static class QueryHandler implements HttpHandler {
        @Override
        public void handle(HttpExchange exchange) throws IOException {
            exchange.getResponseHeaders().add("Access-Control-Allow-Origin", "*");
            exchange.getResponseHeaders().add("Access-Control-Allow-Methods", "POST, OPTIONS");

            if ("OPTIONS".equals(exchange.getRequestMethod())) {
                exchange.sendResponseHeaders(204, -1);
                return;
            }

            String response = "";
            int statusCode = 200;

            try (Connection conn = DriverManager.getConnection(DB_URL, USER, PASS)) {
                if ("POST".equals(exchange.getRequestMethod())) {
                    InputStream is = exchange.getRequestBody();
                    String body = new String(is.readAllBytes(), StandardCharsets.UTF_8);
                    
                    String query = "";
                    String[] pairs = body.split("&amp;");
                    for (String pair : pairs) {
                        String[] kv = pair.split("=");
                        if (kv.length == 2 &amp;&amp; "query".equals(kv[0])) {
                            query = java.net.URLDecoder.decode(kv[1], StandardCharsets.UTF_8);
                        }
                    }

                    if (query != null &amp;&amp; !query.trim().isEmpty()) {
                        try (Statement stmt = conn.createStatement()) {
                            boolean isResultSet = stmt.execute(query);
                            if (isResultSet) {
                                try (ResultSet rs = stmt.getResultSet()) {
                                    ResultSetMetaData rsmd = rs.getMetaData();
                                    int colCount = rsmd.getColumnCount();
                                    StringBuilder sb = new StringBuilder();
                                    sb.append("[");
                                    boolean firstRow = true;
                                    while (rs.next()) {
                                        if (!firstRow) sb.append(",");
                                        sb.append("{");
                                        for (int i = 1; i &lt;= colCount; i++) {
                                            if (i &gt; 1) sb.append(",");
                                            sb.append("\"").append(rsmd.getColumnName(i)).append("\":\"");
                                            String val = rs.getString(i);
                                            sb.append(val != null ? val.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n") : "");
                                            sb.append("\"");
                                        }
                                        sb.append("}");
                                        firstRow = false;
                                    }
                                    sb.append("]");
                                    response = "{\"status\":\"success\", \"data\":" + sb.toString() + "}";
                                }
                            } else {
                                int updateCount = stmt.getUpdateCount();
                                response = "{\"status\":\"success\", \"message\":\"Query executed successfully. Rows affected: " + updateCount + "\"}";
                            }
                        }
                    } else {
                        statusCode = 400;
                        response = "{\"error\": \"Empty query\"}";
                    }
                }
            } catch (SQLException e) {
                statusCode = 500;
                response = "{\"error\": \"" + e.getMessage().replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n") + "\"}";
                e.printStackTrace();
            }

            byte[] bytes = response.getBytes(StandardCharsets.UTF_8);
            exchange.getResponseHeaders().set("Content-Type", "application/json");
            exchange.sendResponseHeaders(statusCode, bytes.length);
            OutputStream os = exchange.getResponseBody();
            os.write(bytes);
            os.close();
        }
    }
}

</pre>

</body>
</html>

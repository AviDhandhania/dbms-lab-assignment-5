    &lt;style&gt;
        :root {
            --primary: #4361ee;
            --primary-hover: #3a56d4;
            --secondary: #2b2d42;
            --background: #f8f9fa;
            --surface: #ffffff;
            --danger: #ef233c;
            --success: #2ec4b6;
            --text-main: #2b2d42;
            --text-muted: #8d99ae;
            --border: #edf2f4;
            --accent: #f72585;
        }

        body { font-family: 'Inter', sans-serif; margin: 0; padding: 0; background-color: var(--background); color: var(--text-main); }
        header { background-color: var(--secondary); color: white; padding: 20px 40px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); display: flex; justify-content: space-between; align-items: center; }
        header h1 { margin: 0; font-weight: 600; font-size: 24px; }
        .status-badge { background-color: rgba(46, 196, 182, 0.2); color: var(--success); padding: 5px 12px; border-radius: 20px; font-size: 13px; font-weight: 600; border: 1px solid var(--success); }

        .container { max-width: 1200px; margin: 30px auto; padding: 0 20px; display: grid; grid-template-columns: 1fr; gap: 30px; }

        .card { background: var(--surface); border-radius: 12px; padding: 25px; box-shadow: 0 10px 15px -3px rgba(0,0,0,0.05); border: 1px solid var(--border); }
        .card-header { display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid var(--border); padding-bottom: 10px; margin-bottom: 20px; }
        .card-header h2 { margin: 0; color: var(--secondary); font-size: 20px; }

        .form-group { margin-bottom: 15px; }
        label { display: block; margin-bottom: 8px; font-weight: 600; font-size: 14px; color: var(--secondary); }
        input[type="text"], input[type="email"], textarea, select { width: 100%; padding: 10px; box-sizing: border-box; border: 1px solid #dcdcdc; border-radius: 6px; font-size: 14px; font-family: 'Inter', sans-serif; }
        input:focus, textarea:focus, select:focus { outline: none; border-color: var(--primary); }
        textarea { resize: vertical; min-height: 120px; font-family: 'Courier New', Courier, monospace; }

        button { padding: 10px 18px; background-color: var(--primary); color: white; border: none; border-radius: 6px; cursor: pointer; font-weight: 600; font-size: 13px; transition: background-color 0.2s; }
        button:hover { background-color: var(--primary-hover); }
        .cancel-btn { background-color: var(--text-muted); }
        .cancel-btn:hover { background-color: #6c757d; }
        .danger-btn { background-color: var(--danger); }
        .danger-btn:hover { background-color: #d90429; }
        .secondary-btn { background-color: var(--accent); }
        .secondary-btn:hover { background-color: #d1136b; }

        table { width: 100%; border-collapse: collapse; font-size: 14px; }
        th, td { padding: 10px 15px; border-bottom: 1px solid var(--border); text-align: left; }
        th { background-color: #f8f9fa; font-weight: 600; color: var(--text-muted); text-transform: uppercase; font-size: 12px; }
        tr:hover { background-color: #fcfcfc; }

        .alert { padding: 10px; border-radius: 4px; margin-bottom: 15px; display: none; font-size: 14px; }
        .alert.success { background-color: #d4edda; color: #155724; border: 1px solid #c3e6cb; }
        .alert.error { background-color: #f8d7da; color: #721c24; border: 1px solid #f5c6cb; }

        .toolbar { display: flex; gap: 10px; align-items: center; margin-bottom: 15px; background: #f8f9fa; padding: 15px; border-radius: 8px; border: 1px solid #edf2f4; }
        
        #dynamicFormArea { background: #fdfdfd; padding: 20px; border-radius: 8px; border: 1px solid var(--primary); margin-bottom: 20px; display: none; }
        
        /* Query Runner Styles */
